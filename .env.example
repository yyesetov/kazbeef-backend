# Скопируйте в .env и заполните. Файл .env не коммитится.
DB_USER=kazbeef
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Контакт владельца для User-Agent при обращении к источникам
KAZBEEF_CONTACT_EMAIL=

# --- необязательное ---
# ИИ: перевод и резюме событий (Claude). Без ключа сервис работает без них.
# ANTHROPIC_API_KEY=
# Модель: по умолчанию claude-opus-5-5; для массового перевода дешевле claude-haiku-5-5
# KAZBEEF_AI_MODEL=
# Модель чата по базе знаний: по умолчанию claude-opus-5-5; для самых быстрых ответов — claude-haiku-5-5
# KAZBEEF_CHAT_MODEL=
# Оповещения в Telegram: токен бота от @BotFather и id чата
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Оповещения по почте
# KAZBEEF_ALERT_EMAIL_TO=
# KAZBEEF_ALERT_EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Адрес интерфейса (фронтенда) в ссылках из оповещений. Интерфейс — отдельный проект,
# по умолчанию его контейнер слушает порт 3000
# KAZBEEF_PUBLIC_URL=http://localhost:3000

# --- сервер (deploy/docker-compose.server.yml) ---
# Адрес API с HTTPS. Без своего домена: IP сервера через дефисы + .sslip.io, например 203-0-113-10.sslip.io
# API_HOST=
# Адрес интерфейса (Cloudflare Workers): с него разрешены запросы к API
# KAZBEEF_CORS_ORIGINS=https://kazbeef-frontend.yyessetov.workers.dev
