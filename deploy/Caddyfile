# Обратный прокси с автоматическим HTTPS (Let's Encrypt).
# API_HOST — адрес сервера, например 203-0-113-10.sslip.io или api.kazbeef.kz
{$API_HOST} {
	encode gzip

	# документы базы знаний — до 50 МБ, несколько за раз
	request_body {
		max_size 200MB
	}

	reverse_proxy app:8080 {
		# ответ чата идёт потоком: отдавать куски сразу, без буферизации
		flush_interval -1
		transport http {
			read_timeout 300s
		}
	}
}
